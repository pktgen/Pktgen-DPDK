#!/usr/bin/env bash
# Pre-commit hook for Markdown linting.
# Usage: ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit
# Requires Node.js 22+ and dependencies installed with npm ci.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-commit] npm not found. Install Node.js 22+ and run npm ci." >&2
  exit 1
fi

npm run lint:markdown

echo "[pre-commit] Markdown lint passed."
